    {
      "id": "footer-rules",
      "type": "text",
      "x": 40,
      "y": 1850,
      "width": 1442,
      "height": 191.1,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 21,
      "frameId": null,
      "groupIds": [],
      "index": "a68",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Neo Noted: t left • r right • m up • n down • gg or b: home / first • G or l: end / last\nArrow keys and Home / End also navigate. Ctrl-w then an arrow or profile direction focuses a pane.\ngt / gT: tabs • i: edit • Esc: leave editing or preview • q: quit in NORMAL\nyy: selected value • ya: all values • yq: query • letter shortcuts stay inactive while typing\nconfig.toml selects keybindings/neo-noted.keybinding.toml or keybindings/qwerty.keybinding.toml.\nStart + outcome events form one encounter. Missing outcome = unfinished; invalid input is not recorded.\nFailures and unfinished entries allow query copying. Review and copy actions never append events.",
      "roughness": 1,
      "roundness": null,
      "seed": 776720,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Neo Noted: t left • r right • m up • n down • gg or b: home / first • G or l: end / last\nArrow keys and Home / End also navigate. Ctrl-w then an arrow or profile direction focuses a pane.\ngt / gT: tabs • i: edit • Esc: leave editing or preview • q: quit in NORMAL\nyy: selected value • ya: all values • yq: query • letter shortcuts stay inactive while typing\nconfig.toml selects keybindings/neo-noted.keybinding.toml or keybindings/qwerty.keybinding.toml.\nStart + outcome events form one encounter. Missing outcome = unfinished; invalid input is not recorded.\nFailures and unfinished entries allow query copying. Review and copy actions never append events.",
      "textAlign": "center",
      "updated": 1789846360944,
      "version": 1,
      "versionNonce": 1241961452,
      "verticalAlign": "middle"
    },
